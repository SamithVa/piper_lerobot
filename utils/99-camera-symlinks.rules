# Persistent symlinks for piper_lerobot cameras.
#
# All 3 cameras are the SAME model (05a3:9230) with the SAME serial, so they can
# only be distinguished by physical USB port. They hang off a USB hub/extender;
# their position INSIDE the extender is stable (.1.3 / .1.4.1 / .1.4.2), while the
# PC-uplink prefix (3-8 / 3-9 / 3-10 ...) changes whenever the extender is moved to
# a different PC port. So we match the stable port SUFFIX with a glob (KERNELS
# supports shell patterns) instead of the full path -> survives replugging.
#
# ATTR{index}=="0" pins the symlink to the capture node (index 1 is metadata).
# Constrained by idVendor/idProduct so the glob can't grab unrelated devices.
#
# NOTE: robust to moving the extender's uplink, NOT to moving a camera into a
# different socket of the extender (that changes its suffix). If you re-socket a
# camera, update the matching suffix here.

# l_wrist camera - extender port suffix .1.3
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="05a3", ATTRS{idProduct}=="9230", KERNELS=="*.1.3", ATTR{index}=="0", SYMLINK+="l_wrist"

# top camera - extender port suffix .1.4.1
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="05a3", ATTRS{idProduct}=="9230", KERNELS=="*.1.4.1", ATTR{index}=="0", SYMLINK+="top"

# r_wrist camera - extender port suffix .1.4.2
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="05a3", ATTRS{idProduct}=="9230", KERNELS=="*.1.4.2", ATTR{index}=="0", SYMLINK+="r_wrist"
